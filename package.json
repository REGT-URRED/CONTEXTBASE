{
  "name": "contextbase",
  "version": "1.5.0",
  "description": "Sistema minimalista y universal de memoria persistente automática para proyectos y agentes de código (OpenCode, Kilo Code, Claude Code, Cursor, Antigravity, etc.)",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "contextbase": "bin/contextbase.js",
    "cb": "bin/contextbase.js",
    "openwiki": "bin/contextbase.js"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/REGT-URRED/CONTEXTBASE.git"
  },
  "homepage": "https://github.com/REGT-URRED/CONTEXTBASE#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node ./bin/contextbase.js",
    "postinstall": "node ./bin/contextbase.js setup --global --silent",
    "auto": "node ./bin/contextbase.js auto",
    "watch": "node ./bin/contextbase.js watch",
    "test": "node --test",
    "audit": "node ./bin/contextbase.js audit",
    "mcp": "node ./bin/contextbase.js mcp",
    "pack:release": "npm pack",
    "test:ci": "node --test",
    "release:github": "node scripts/release-github.mjs"
  },
  "keywords": [
    "contextbase",
    "memory",
    "ai-agents",
    "bitacora",
    "repomix",
    "opencode",
    "kilo",
    "antigravity",
    "claude-code",
    "cursor",
    "changelog",
    "tasklist"
  ],
  "author": "REGT-URRED <U19211826@utp.edu.pe>",
  "license": "MIT"
}
